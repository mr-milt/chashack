# React (Vite) client for — dev image with hot reload.
# Build context is the repository root (see docker-compose.yml).
FROM node:22-alpine

WORKDIR /app

COPY package.json  package-lock.json ./
RUN npm ci

COPY . .

# Vite dev server default port.
EXPOSE 5173

# --host makes Vite listen on 0.0.0.0 so the port is reachable from outside the
# container.
CMD ["npm", "run", "dev:remote", "--", "--host", "0.0.0.0"]
