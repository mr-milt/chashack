# nginx config for codecats - proxies to the Vite dev server (client container)

# Port 80: Let's Encrypt challenge + redirect everything else to HTTPS
server {
    listen 80;
    server_name codecats.kodkaos.xyz;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# Port 443: TLS, proxy to React
server {
    listen 443 ssl;
    http2 on;
    server_name codecats.kodkaos.xyz;

    ssl_certificate     /etc/letsencrypt/live/codecats.kodkaos.xyz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/codecats.kodkaos.xyz/privkey.pem;

    location / {
        proxy_pass http://client:5173;
        proxy_http_version 1.1;

        # WebSocket support (Vite hot reload)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Vite blocks unknown Host headers; localhost is always allowed
        proxy_set_header Host localhost;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 86400;
    }
}